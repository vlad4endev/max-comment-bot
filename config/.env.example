BOT_TOKEN=your_token_from_max
TG_READER_BOT_TOKEN=your_telegram_bot_token_here
# Архив канала (MTProto, user-аккаунт): https://my.telegram.org/apps → npm run tg:user-login
# MTProto (архив канала) — можно настроить в админке: Импорт TG→MAX → блок MTProto
# Либо через .env / npm run tg:user-login:
# TG_API_ID=12345678
# TG_API_HASH=your_api_hash
# TG_USER_SESSION=long_session_string_from_tg_user_login
# Telegram Bot API (заполняется автоматически при подключении в /admin → Интеграции)
# TG_TOKEN=your_telegram_bot_token
# Интервал проверки авторизации Telegram API (мс, по умолчанию 300000)
# TELEGRAM_HEALTH_CHECK_INTERVAL_MS=300000
OWNER_USER_ID=122099994
# Вход в /admin (можно переопределить; по умолчанию заданы значения для локального доступа)
# ADMIN_PANEL_USER=vladislav4endev
# ADMIN_PANEL_PASSWORD=your_secure_password
# Отдельный секрет подписи cookie (иначе выводится из BOT_TOKEN)
# ADMIN_PANEL_SESSION_SECRET=random_long_string
ADMIN_CHAT_ID=123456789
BOT_NICKNAME=your_bot_nickname
PORT=3000
# Опционально: отдельный порт для HTTP (иначе = PORT). Для Docker обычно один порт.
# API_PORT=3001

# Mini App (MAX + Telegram): публичный HTTPS, путь /miniapp.
# Должен открываться с телефона по мобильному интернету, не только по Wi‑Fi.
# Тот же URL укажите в панели MAX (dev.max.ru → бот → Mini App) и в BotFather (Telegram).
# Если не задан — подставится из WEBHOOK_URL → …/miniapp (например https://bot.example.com/miniapp).
# BOT_NICKNAME должен совпадать с ботом в MAX (для ссылок max.ru/<nick>?startapp=…).
# MINI_APP_URL=https://yourdomain.com/miniapp

NODE_ENV=development

# Интервал опроса каналов (мс) для кнопки «Комментарии» на постах. Минимум 3000. По умолчанию 30000.
# CHANNEL_POLL_INTERVAL_MS=3000

# Интервал опроса потоков TG→MAX (мс). По умолчанию 5000.
# FLOW_POLL_INTERVAL_MS=5000

# Сколько часов комментарии в MAX закрыты после первого комментария из Telegram/VK. По умолчанию 8.
# COMMENTS_BOOKING_LOCK_HOURS=8

# Rate limiting Telegram Bot API при синхронизации комментариев (мс между запросами). По умолчанию 350.
# TELEGRAM_API_MIN_INTERVAL_MS=350

# Сколько комментариев обрабатывать за цикл синхронизации MAX→TG. По умолчанию 15.
# TELEGRAM_COMMENT_SYNC_BATCH_SIZE=15

# Интервал цикла синхронизации комментариев MAX→TG (мс). По умолчанию 2000.
# MAX_COMMENT_SYNC_INTERVAL_MS=2000

# Режим получения событий: webhook | polling (если не задан — в production webhook, иначе polling)
# MAX_RECEIVE_MODE=polling

# Для webhook (production): полный HTTPS-URL, как при POST /subscriptions (домен с валидным TLS, публичный порт 443 снаружи)
# WEBHOOK_URL=https://your-domain.example/webhook

# Секрет для заголовка X-Max-Bot-Api-Secret (5–256 символов: A–Z, a–z, 0–9, _, -). В production обязателен.
# WEBHOOK_SECRET=your_random_secret_here

# Опционально: Redis для общего кэша между процессами (miniapp, prune, recovery dedup).
# Без REDIS_URL приложение работает с in-memory кэшем как раньше.
# REDIS_URL=redis://127.0.0.1:6379

# ИИ-анализ логов настраивается только в админ-панели: Настройки → Оператор ИИ
# (ключ и модель сохраняются локально в data/log-ai-config.json)

# Отдельный WireGuard только для Telegram (не пересекается с чужим wg0 на хосте).
# COMPOSE_PROFILES=telegram-vpn
# TELEGRAM_PROXY_URL=socks5://wg-telegram:1080
# Инструкция: deploy/wireguard/README.md

# Прокси для Telegram (админка: Настройки → Прокси Telegram).
# Можно один раз задать ссылку — дальше список хранится в data/telegram-proxies.json
# TELEGRAM_PROXY_URL=vless://uuid@host:443?security=reality&pbk=...#name
# TELEGRAM_PROXY_URL=hysteria2://password@host:443?insecure=1&sni=example.com#hy2
# TELEGRAM_PROXY_URL=hy2://password@host:443?obfs=salamander&obfs-password=secret
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
# Для ключей VLESS на сервере должен быть xray-core (бинарник в PATH или XRAY_BIN)
# XRAY_BIN=/usr/local/bin/xray
# Для Hysteria2 предпочтителен официальный клиент hysteria (иначе xray-core 26+)
# HYSTERIA_BIN=/usr/local/bin/hysteria
