BOT_TOKEN=your_token_from_max
ADMIN_CHAT_ID=123456789
BOT_NICKNAME=your_bot_nickname
PORT=3000
# Опционально: отдельный порт для HTTP (иначе = PORT). Для Docker обычно один порт.
# API_PORT=3001

# Опционально: legacy URL мини-приложения с query post_id/chat_id (если не используете deep link MAX через BOT_NICKNAME).
# MINI_APP_URL=https://yourdomain.com/miniapp

NODE_ENV=development

# Режим получения событий: webhook | polling (если не задан — в production webhook, иначе polling)
# MAX_RECEIVE_MODE=polling

# Для webhook (production): полный HTTPS-URL, как при POST /subscriptions (домен с валидным TLS, публичный порт 443 снаружи)
# WEBHOOK_URL=https://your-domain.example/webhook

# Секрет для заголовка X-Max-Bot-Api-Secret (5–256 символов: A–Z, a–z, 0–9, _, -). В production обязателен.
# WEBHOOK_SECRET=your_random_secret_here
